<Window x:Class="SaturnNetLobby.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saturn NetLobby"
        Height="400"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="SATURN NETLOBBY"
                   FontSize="28"
                   FontWeight="Bold"/>

        <!-- Mednafen label -->
        <TextBlock Grid.Row="2"
                   Text="Mednafen"
                   FontWeight="Bold"/>

        <!-- Mednafen selection -->
        <Grid Grid.Row="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MednafenPathBox"
                     Grid.Column="0"
                     Height="30"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="BrowseMednafenButton"
                    Grid.Column="1"
                    Content="Browse..."
                    Margin="10,0,0,0"/>
        </Grid>

        <!-- Game label -->
        <TextBlock Grid.Row="5"
                   Text="Saturn Game"
                   FontWeight="Bold"/>

        <!-- Game selection -->
        <Grid Grid.Row="6" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="GamePathBox"
                     Grid.Column="0"
                     Height="30"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="BrowseGameButton"
                    Grid.Column="1"
                    Content="Browse..."
                    Margin="10,0,0,0"/>
        </Grid>

        <!-- Launch -->
        <Button x:Name="LaunchButton"
                Grid.Row="8"
                Content="LAUNCH SATURN"
                Width="180"
                Height="45"
                HorizontalAlignment="Left"
                FontWeight="Bold"/>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="10"
                   Text="Status: Ready"
                   FontSize="14"/>

    </Grid>
</Window>